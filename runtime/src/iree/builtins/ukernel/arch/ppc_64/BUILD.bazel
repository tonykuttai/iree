load("//build_tools/bazel:build_defs.oss.bzl", "iree_cmake_extra_content")
load("//build_tools/bazel:iree_bitcode_library.bzl", "iree_bitcode_library", "iree_link_bitcode")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

#===------------------------------------------------------------------------===#
# UKernel bitcode files
#===------------------------------------------------------------------------===#

iree_cmake_extra_content(
    content = """
iree_compiler_targeting_iree_arch(_IREE_UKERNEL_BITCODE_BUILD_PPC_64 "ppc_64")
if(_IREE_UKERNEL_BITCODE_BUILD_PPC_64)
""",
    inline = True,
)

# All headers transitively included by code in this directory. Bazel-only.
UKERNEL_PPC_64_INTERNAL_HEADERS = [
    "common_ppc_64.h",
    "mmt4d_ppc_64_internal.h",
    "mmt4d_ppc_64_tiles.inl",
    "pack_ppc_64_internal.h",
    "unpack_ppc_64_internal.h",
    "//runtime/src/iree/builtins/ukernel:internal_headers_filegroup",
    "//runtime/src/iree/schemas:cpu_data_headers_filegroup",
]

iree_bitcode_library(
    name = "ukernel_bitcode_arch_ppc_64_entry_points",
    srcs = [
        "mmt4d_ppc_64_entry_point.c",
        "pack_ppc_64_entry_point.c",
        "unpack_ppc_64_entry_point.c",
    ],
    arch = "ppc_64",
    internal_hdrs = UKERNEL_PPC_64_INTERNAL_HEADERS,
)

iree_bitcode_library(
    name = "ukernel_bitcode_arch_ppc_64_mma",
    srcs = [
        "mmt4d_ppc_64_mma.c",
    ],
    arch = "ppc_64",
    copts = ["-mcpu=pwr10", "-mmma"],
    internal_hdrs = UKERNEL_PPC_64_INTERNAL_HEADERS,
)

iree_link_bitcode(
    name = "ukernel_bitcode_arch_ppc_64",
    bitcode_files = [
        "ukernel_bitcode_arch_ppc_64_entry_points.bc",
        "ukernel_bitcode_arch_ppc_64_mma.bc",
    ],
)

iree_cmake_extra_content(
    content = """
elseif(IREE_BUILD_COMPILER AND IREE_TARGET_BACKEND_LLVM_CPU)
iree_make_empty_file("${CMAKE_CURRENT_BINARY_DIR}/ukernel_bitcode_arch_ppc_64.bc")
endif()  # _IREE_UKERNEL_BITCODE_BUILD_PPC_64
""",
    inline = True,
)
